# 複製成 .env 後填入自己的值。.env 不會被 git 追蹤(見 .gitignore)。

# DuckDB 事實表路徑,預設 data/taiwan_stock.duckdb(相對 repo 根目錄)
DUCKDB_PATH=

# FinMind 備援資料源:https://finmindtrade.com/ 註冊並驗證信箱可取得 token,
# 免費額度由 300/hr 提高到 600/hr。不填也能跑,只是備援功能停用。
FINMIND_TOKEN=

# LINE Developers Console (https://developers.line.biz/console/) 建立
# Messaging API channel 後取得。兩者都沒填時,line_bot.py 會用 log 印出
# 回覆內容而不是真的呼叫 LINE API,方便本地開發不用先申請帳號。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# HTTP 行為(有合理預設值,通常不用改)
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3

# 提醒旗標,不是技術存取控制——本系統設計上就不該對外公開。
PERSONAL_USE_ONLY=true
